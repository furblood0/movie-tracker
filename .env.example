# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
# .env dosyasi harici bir paket (dotenv) ile degil, src/config.js icindeki
# kendi mini ayristiricimiz ile okunur.

# Sunucunun dinleyecegi port ve host
# Ters proxy ayni makinedeyse 127.0.0.1 kalsin; konteynerde 0.0.0.0 yapin.
PORT=3000
HOST=127.0.0.1

# "development" | "production"
NODE_ENV=development

# Onunde X-Forwarded-For yazan bir ters proxy (Caddy/nginx) VARSA true yapin.
# Proxy yokken true yapmayin: istemci basligi uydurup hiz sinirlarini delebilir.
TRUST_PROXY=false

# Oturum cerezine Secure bayragi eklensin mi?
# Bos birakilirsa production'da true, gelistirmede false kabul edilir.
# HTTPS olmadan true yaparsaniz tarayici cerezi gondermez ve giris calismaz.
# COOKIE_SECURE=

# Kayit modu: open (herkes) | invite (davet kodu ile) | closed (kapali)
REGISTRATION_MODE=open

# REGISTRATION_MODE=invite icin zorunlu. Uzun ve rastgele bir deger secin.
INVITE_CODE=

# TMDb v3 API anahtari (https://www.themoviedb.org/settings/api)
# Asla istemciye gonderilmez; tum TMDb istekleri sunucudan proxy'lenir.
TMDB_API_KEY=

# Alternatif olarak v4 "Read Access Token" (Bearer) kullanilabilir.
# Ikisi de doluysa Bearer token tercih edilir.
TMDB_BEARER_TOKEN=

# TMDb icerik dili ve bolgesi
TMDB_LANGUAGE=tr-TR
TMDB_REGION=TR

# Oturum cerezinin gecerlilik suresi (gun)
SESSION_TTL_DAYS=30

# SQLite dosyasinin yolu (proje kokune gore relatif olabilir)
DB_PATH=data/movie-tracker.sqlite
